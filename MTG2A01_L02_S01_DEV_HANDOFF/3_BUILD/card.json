  "audio_text": {
   "vo_t1_1a": "यह है टप्पू मेंढक।",
   "vo_t1_1b": "उसका दोस्त पुल के उस पार है।",
   "vo_t1_1c": "टप्पू दो-दो कदम की छलाँग लगाकर अपने दोस्त से मिलने जाएगा। आइए, उसके साथ गिनते हैं!",
   "vo_t1_2a": "टप्पू शून्य पर है।",
   "vo_t1_2b": "आइए, यहाँ से दो कदम आगे गिनते हैं—",
   "vo_c_1": "एक,",
   "vo_c_2": "दो,",
   "vo_t1_2c": "टप्पू दो कदम की छलाँग लगाकर दो की संख्या पर पहुँच गया!",
   "vo_t1_3a": "अब टप्पू दो पर है। वह दो कदम की छलाँग लगाकर कहाँ पहुँचेगा?",
   "vo_t1_3b": "आइए, दो से आगे दो कदम गिनते हैं—",
   "vo_c_3": "तीन,",
   "vo_c_4": "चार,",
   "vo_t1_3c": "टप्पू चार पर पहुँच गया!",
   "vo_t1_4x": "टप्पू ने फिर दो कदम की छलाँग लगाई और छह पर पहुँच गया!",
   "vo_t1_4": "टप्पू ने फिर दो कदम की छलाँग लगाई और आठ पर पहुँच गया!",
   "vo_t1_5": "दो कदम की एक और छलाँग—दस! टप्पू अपने दोस्त से मिल गया!",
   "vo_t1_6a": "टप्पू अपने दोस्त से मिल गया!",
   "vo_t1_6b": "हमने दो-दो की गिनती करके उसे पुल पार कराया—",
   "vo_c_6": "छह,",
   "vo_c_8": "आठ,",
   "vo_c_10": "दस,",
   "vo_t2_1": "टप्पू का एक और दोस्त पुल के उस पार इंतज़ार कर रहा है। इस बार टप्पू पाँच-पाँच कदम की छलाँग लगाकर उससे मिलने जाएगा। आइए, टप्पू के साथ गिनते हैं!",
   "vo_t2_2a": "टप्पू शून्य पर है। यहाँ से पाँच कदम आगे गिनते हैं—",
   "vo_c_5": "पाँच,",
   "vo_t2_2b": "टप्पू पाँच पर पहुँच गया!",
   "vo_t2_3": "टप्पू पाँच से पाँच कदम आगे कूदकर दस पर पहुँच गया!",
   "vo_t2_4": "फिर पाँच कदम की छलाँग लगाई और पंद्रह पर पहुँच गया!",
   "vo_t2_5": "एक और पाँच कदम की छलाँग! अब टप्पू बीस पर है।",
   "vo_t2_6": "अब आप टप्पू पर टैप कीजिए। वह पाँच कदम आगे कूदेगा!",
   "vo_t2_7": "देखिए! टप्पू पच्चीस पर पहुँच गया!",
   "vo_t2_8": "टप्पू पर फिर टैप कीजिए।",
   "vo_t2_9": "पाँच कदम की एक और छलाँग लगाकर टप्पू तीस पर पहुँच गया!",
   "vo_met": "वाह! टप्पू अपने दोस्त से मिल गया!",
   "vo_c_15": "पंद्रह,",
   "vo_c_20": "बीस,",
   "vo_c_25": "पच्चीस,",
   "vo_c_30": "तीस,",
   "vo_t2_11": "ऐसे हम पाँच-पाँच करके गिनते हैं।",
   "vo_t3_1": "टप्पू का एक और दोस्त पुल के उस पार है। इस बार टप्पू दस-दस कदम की छलाँग लगाकर उससे मिलने जाएगा। आइए, उसके साथ गिनते हैं!",
   "vo_t3_2a": "टप्पू शून्य पर है।",
   "vo_t3_2b": "वह दस कदम की छलाँग लगाकर दस पर पहुँच गया!",
   "vo_t3_3": "फिर दस कदम की छलाँग लगाई और बीस पर पहुँच गया!",
   "vo_t3_4": "एक और दस कदम की छलाँग! अब टप्पू तीस पर है।",
   "vo_t3_5": "अब आप टप्पू पर टैप कीजिए। वह दस कदम आगे कूदेगा!",
   "vo_t3_6": "देखिए! टप्पू चालीस पर पहुँच गया!",
   "vo_t3_8": "दस कदम की एक और छलाँग लगाकर टप्पू पचास पर पहुँच गया!",
   "vo_t3_9b": "हमने दस-दस करके गिना—",
   "vo_c_40": "चालीस,",
   "vo_c_50": "पचास,",
   "vo_q1_a": "मेंढक को आगे जाना है।",
   "vo_q1_b": "वह पचास पर है।",
   "vo_q1_c": "पाँच कदम की छलाँग लगाकर वह किस संख्या पर पहुँचेगा? सही संख्या पर टैप कीजिए।",
   "vo_q1_wa1": "मेंढक पचास पर है। पाँच कदम आगे कहाँ पहुँचेगा? सही संख्या पर टैप कीजिए।",
   "vo_q1_wa2": "पचास से पाँच कदम आगे देखिए।",
   "vo_q1_wa3": "मेंढक पाँच कदम की छलाँग लगाकर पचपन पर पहुँचेगा।",
   "vo_q1_ok": "शाबाश! पाँच कदम आगे - पचपन!",
   "vo_q2_a": "मेंढक चौदह पर है।",
   "vo_q2_b": "दो कदम आगे कहाँ पहुँचेगा? सही संख्या पर टैप कीजिए।",
   "vo_q2_wa2": "चौदह से दो कदम आगे देखिए।",
   "vo_q2_wa3": "मेंढक दो कदम की छलाँग लगाकर सोलह पर पहुँचेगा।",
   "vo_q2_ok": "शाबाश! दो कदम आगे—सोलह!",
   "vo_q3_a": "मेंढक तीस पर है।",
   "vo_q3_b": "दस कदम आगे कहाँ पहुँचेगा? सही संख्या पर टैप कीजिए।",
   "vo_q3_wa2": "तीस से दस कदम आगे देखिए।",
   "vo_q3_wa3": "मेंढक दस कदम की छलाँग लगाकर चालीस पर पहुँचेगा।",
   "vo_q3_ok": "शाबाश! दस कदम आगे—चालीस!",
   "vo_q4_1": "टिड्डा तीस पर है। आइए, उसके साथ दो-दो करके गिनते हैं।",
   "vo_q4_2": "बत्तीस…",
   "vo_q4_3": "चौंतीस…",
   "vo_q4_4": "छत्तीस!",
   "vo_q4_5": "अगली छलाँग में टिड्डा कहाँ पहुँचेगा? सही संख्या पर टैप कीजिए।",
   "vo_q4_ok": "शाबाश! छत्तीस से दो आगे—अड़तीस!",
   "vo_q4_wa1": "दो-दो करके गिनिए। अगली सही संख्या पर टैप कीजिए।",
   "vo_q4_hint": "छत्तीस से दो कदम आगे देखिए।",
   "vo_q4_wa3": "टिड्डा दो कदम की छलाँग लगाकर अड़तीस पर पहुँचेगा।",
   "vo_q4_after": "अगली संख्या क्या होगी? सही संख्या पर टैप कीजिए।",
   "vo_q5_q": "खरगोश दो-दो करके गिन रहा है। उसकी गिनती में दो संख्याएँ छूट गई हैं। सही संख्याओं पर टैप करके गिनती पूरी कीजिए।",
   "vo_q5_ok1": "सही! सोलह से दो आगे—अठारह!",
   "vo_q5_wa1": "दो-दो करके गिनिए। खाली जगह के लिए सही संख्या पर टैप कीजिए।",
   "vo_q5_hint1": "सोलह से दो कदम आगे देखिए।",
   "vo_q5_wa3a": "खरगोश दो कदम की छलाँग लगाकर अठारह पर पहुँचेगा।",
   "vo_after_tap": "सही संख्या पर टैप कीजिए।",
   "vo_q5_ok2": "शाबाश! अठारह से दो आगे—बीस!",
   "vo_q5_hint2": "अठारह से दो कदम आगे देखिए।",
   "vo_q5_wa3b": "खरगोश दो कदम की छलाँग लगाकर बीस पर पहुँचेगा।",
   "vo_q6_q": "गिलहरी पाँच-पाँच करके आगे गिन रही है। उसकी गिनती पूरी करने में मदद कीजिए। खाली जगहों के लिए सही संख्याओं पर टैप कीजिए।",
   "vo_q6_ok1": "सही! पैंसठ के बाद पाँच आगे गिनने पर सत्तर आता है।",
   "vo_q6_wa1": "पाँच-पाँच करके गिनिए। सही संख्या पर टैप कीजिए।",
   "vo_q6_hint1": "पैंसठ से पाँच कदम आगे देखिए।",
   "vo_q6_wa3a": "पाँच कदम की छलाँग लगाकर सत्तर पर पहुँचेगा।",
   "vo_q6_ok2": "शाबाश! सत्तर से पाँच आगे गिनने पर पचहत्तर आता है। गिलहरी की गिनती पूरी हो गई!",
   "vo_q6_hint2": "सत्तर से पाँच कदम आगे देखिए।",
   "vo_q6_wa3b": "गिलहरी पाँच कदम की छलाँग लगाकर पचहत्तर पर पहुँचेगी।",
   "vo_q7_q": "दस-दस करके गिनिए। खाली जगह के लिए सही संख्या पर टैप कीजिए।",
   "vo_q7_ok1": "सही! साठ से दस आगे—सत्तर!",
   "vo_q7_wa1": "दस-दस करके गिनिए। सही संख्या पर टैप कीजिए।",
   "vo_q7_hint1": "साठ से दस कदम आगे देखिए।",
   "vo_q7_wa3a": "टिड्डा दस कदम की छलाँग लगाकर सत्तर पर पहुँचेगा।",
   "vo_q7_pre1": "साठ से दस आगे गिनिए।",
   "vo_q7_ok2": "शाबाश! अस्सी से दस आगे—नब्बे!",
   "vo_q7_hint2": "अस्सी से दस कदम आगे देखिए।",
   "vo_q7_wa3b": "टिड्डा दस कदम की छलाँग लगाकर नब्बे पर पहुँचेगा।",
   "vo_q7_pre2": "अस्सी से दस आगे गिनिए।",
   "vo_landing": "नमस्ते! आज हम टप्पू मेंढक के साथ कूद-कूद कर गिनती करेंगे — दो-दो, पाँच-पाँच और दस-दस की कूद!",
   "vo_pt_tutorial": "ध्यान से देखिए और मेरे साथ जानिए। चलिए, शुरू करें!",
   "vo_pt_guided": "बहुत बढ़िया! अब हम साथ मिलकर शुरू करते हैं। चलिए, साथ में करें!",
   "vo_pt_practice": "वाह! अब आपकी बारी।",
   "vo_well_done": "शाबाश! तुमने कूद-कूद कर गिनती सीख ली!",
   "vo_g_n_23": "तेईस!",
   "vo_g_n_25": "पच्चीस!",
   "vo_g_n_27": "सत्ताईस!",
   "vo_g_n_29": "उनतीस!",
   "vo_g_n_31": "इकतीस!",
   "vo_g_r_2_1": "कुछ साथी यानों में बैठ गए हैं। तेईस से दो-दो करके गिनिए और खाली यानों में सही साथियों को बिठाइए!",
   "vo_g_n_42": "बयालीस!",
   "vo_g_n_44": "चवालीस!",
   "vo_g_n_46": "छियालीस!",
   "vo_g_n_48": "अड़तालीस!",
   "vo_g_n_50": "पचास!",
   "vo_g_r_2_2": "कुछ साथी यानों में बैठ गए हैं। बयालीस से दो-दो करके गिनिए और खाली यानों में सही साथियों को बिठाइए!",
   "vo_g_n_61": "इकसठ!",
   "vo_g_n_63": "तिरसठ!",
   "vo_g_n_65": "पैंसठ!",
   "vo_g_n_67": "सड़सठ!",
   "vo_g_n_69": "उनहत्तर!",
   "vo_g_r_2_3": "कुछ साथी यानों में बैठ गए हैं। इकसठ से दो-दो करके गिनिए और खाली यानों में सही साथियों को बिठाइए!",
   "vo_g_wrong_2": "अरे! दो-दो करके गिनिए। फिर कोशिश कीजिए!",
   "vo_g_done_2": "वाह! दो-दो की गिनती से सभी यान उड़ गए! अब दूसरी गिनती चुनिए।",
   "vo_g_n_30": "तीस!",
   "vo_g_n_35": "पैंतीस!",
   "vo_g_n_40": "चालीस!",
   "vo_g_n_45": "पैंतालीस!",
   "vo_g_r_5_1": "कुछ साथी यानों में बैठ गए हैं। पच्चीस से पाँच-पाँच करके गिनिए और खाली यानों में सही साथियों को बिठाइए!",
   "vo_g_n_55": "पचपन!",
   "vo_g_n_60": "साठ!",
   "vo_g_r_5_2": "कुछ साथी यानों में बैठ गए हैं। चालीस से पाँच-पाँच करके गिनिए और खाली यानों में सही साथियों को बिठाइए!",
   "vo_g_n_70": "सत्तर!",
   "vo_g_n_75": "पचहत्तर!",
   "vo_g_n_80": "अस्सी!",
   "vo_g_n_85": "पचासी!",
   "vo_g_r_5_3": "कुछ साथी यानों में बैठ गए हैं। पैंसठ से पाँच-पाँच करके गिनिए और खाली यानों में सही साथियों को बिठाइए!",
   "vo_g_wrong_5": "अरे! पाँच-पाँच करके गिनिए। फिर कोशिश कीजिए!",
   "vo_g_done_5": "वाह! पाँच-पाँच की गिनती से सभी यान उड़ गए! अब दूसरी गिनती चुनिए।",
   "vo_g_r_10_1": "कुछ साथी यानों में बैठ गए हैं। तीस से दस-दस करके गिनिए और खाली यानों में सही साथियों को बिठाइए!",
   "vo_g_n_90": "नब्बे!",
   "vo_g_r_10_2": "कुछ साथी यानों में बैठ गए हैं। पचास से दस-दस करके गिनिए और खाली यानों में सही साथियों को बिठाइए!",
   "vo_g_n_100": "सौ!",
   "vo_g_r_10_3": "कुछ साथी यानों में बैठ गए हैं। साठ से दस-दस करके गिनिए और खाली यानों में सही साथियों को बिठाइए!",
   "vo_g_wrong_10": "अरे! दस-दस करके गिनिए। फिर कोशिश कीजिए!",
   "vo_g_done_10": "वाह! दस-दस की गिनती से सभी यान उड़ गए! अब दूसरी गिनती चुनिए।",
   "vo_g_menu": "अंतरिक्ष की सैर के लिए यात्री तैयार हैं! सही संख्या वाले यात्रियों को खाली यानों में बिठाइए। पहले चुनिए—दो-दो, पाँच-पाँच या दस-दस की गिनती।",
